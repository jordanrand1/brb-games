# Local: no Twitch credentials means an isolated local demo.
# Hosted: production requires Twitch credentials, owner and security settings.
NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Callback is always PUBLIC_BASE_URL/auth/callback. The older
# TWITCH_REDIRECT_URI is accepted only to derive PUBLIC_BASE_URL when absent.
# Public signup is the default. Set invite to require the optional allowlist.
SIGNUP_MODE=public
ALLOWED_TWITCH_USER_IDS=
OWNER_TWITCH_USER_ID=
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
# Persistent disk on Render. Leave blank locally to use .data/.
BRB_DATA_DIR=
# Word Hunt ALWAYS uses bundled local Numberbatch vectors, including when this key is present.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-6-luna
# Hard application cap, maximum $2; per-channel limit is ten rounds per UTC day.
AI_MONTHLY_BUDGET_USD=2
# Private R2 bucket with a seven-day object-expiration lifecycle rule.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
